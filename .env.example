# Copy to .env.local and fill in. Never commit real values.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL. Use the *pooled* Neon string for the app and the *direct* one for migrations (DATABASE_URL_DIRECT).
# In production DATABASE_URL is the least-privilege app login (howdy_app, `pnpm db:app-role`), never the owner; migrations
# and `pnpm db:app-role` use the owner via MIGRATE_DATABASE_URL. See docs/security/DATABASE_ACCESS.md.
DATABASE_URL=postgres://user:password@localhost:5432/howdy_dev
# DATABASE_URL_DIRECT=
# MIGRATE_DATABASE_URL=           # owner login, used by migrations and `pnpm db:app-role`
TEST_DATABASE_URL=postgres://user:password@localhost:5432/howdy_test

# Redis (rate limiting, pub/sub). Omit in dev to use the in-memory limiter.
REDIS_URL=redis://localhost:6379

# Mail. Production must use resend (it refuses console/file, which would leak verification links into logs).
# MAIL_TRANSPORT=console          # console | file (dev/e2e only) | resend
# MAIL_OUTBOX_DIR=.dev/outbox
# MAIL_FROM=Howdy <no-reply@example.com>   # with resend: an address on a domain verified in Resend
# RESEND_API_KEY=re_...           # required when MAIL_TRANSPORT=resend
# ENABLE_TEST_MAILER=0            # 1 lets a production BUILD use the dev transports (e2e only, never on a real deploy)

# Reverse proxy hops that append to X-Forwarded-For (0 = ignore the header). Used only for rate-limit keys.
# TRUST_PROXY_HOPS=0

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Live Whispers (the realtime process: `pnpm ws`). Optional: unset = everything works over plain HTTP, just without live push.
# WS_PUBLIC_URL is where browsers connect (wss://... in production, same host as the site: the session cookie is host-only).
# It is also the ONLY socket origin the Content-Security-Policy allows.
# WS_PORT=3301
# WS_PUBLIC_URL=ws://localhost:3301
# WS_REVALIDATE_SECONDS=60

# Photos (Portraits). local = files in STORAGE_LOCAL_DIR: development only. Production needs Cloudflare R2 (or any S3-compatible store):
# create a private bucket, an API token with Object Read & Write on that bucket only, and add a CORS rule on the bucket that allows
# PUT from APP_URL (the browser uploads straight to the bucket with a signed URL). The bucket is never public: photos are served by the app.
# STORAGE_DRIVER=local            # local | r2
# STORAGE_LOCAL_DIR=.dev/media
# R2_ACCOUNT_ID=                  # 32 hex characters (Cloudflare dashboard > R2 > overview)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# ENABLE_TEST_STORAGE=0           # 1 lets a production BUILD use local files (e2e only, never on a real deploy)
# Photo check (ADR-039): OpenAI's free moderation model looks at every new photo. Unset = no check.
# OPENAI_API_KEY=sk-...

# Playwright (`pnpm e2e`): database for its production server. Set it when DATABASE_URL points at a remote database.
# E2E_DATABASE_URL=postgres://user:password@localhost:5433/howdy_dev
