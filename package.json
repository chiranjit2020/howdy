{
  "name": "howdy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": ">=1.2.2",
      "http-cache-semantics@<=4.2.0": ">=4.3.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "infra:up": "powershell -NoProfile -File scripts/dev-infra.ps1 up",
    "infra:down": "powershell -NoProfile -File scripts/dev-infra.ps1 down",
    "infra:status": "powershell -NoProfile -File scripts/dev-infra.ps1 status",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm build && playwright test",
    "ws": "tsx scripts/ws.ts",
    "jobs:purge": "tsx scripts/purge.ts",
    "set-role": "tsx scripts/set-role.ts",
    "db:app-role": "tsx scripts/db-app-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/functions": "^3.9.9",
    "ably": "^2.29.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "^16.3.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0"
  }
}
